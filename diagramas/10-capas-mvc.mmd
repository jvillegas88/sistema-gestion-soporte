---
config:
  class:
    padding: 7
    hideEmptyMembersBox: true
  themeCSS: ".nodeLabel, .nodeLabel p, .label foreignObject div { line-height: 1.15 !important; }"
---
classDiagram
    direction TB
    namespace vista {
        class Pantalla {
            <<abstract JDialog>>
            #sesion: Sesion
            #ejecutar(accion) boolean
            +mostrar() boolean
        }
        class PantallaRegistrarIntervencion {
            -controlador: ControladorRegistrarIntervencion
            -panel: PanelIntervencion
            +crear(duenio, sesion, solicitudId)$ PantallaRegistrarIntervencion
            -registrar() void
        }
        class PanelIntervencion {
            +getTipo() TipoIntervencion
            +getTiempo() BigDecimal
            +cargarBorrador(controlador) void
        }
        class Dialogos {
            +ejecutar(padre, accion)$ boolean
        }
    }
    namespace controlador {
        class Sesion {
            -usuario: Integrante
            +registrarIntervencion() ControladorRegistrarIntervencion
        }
        class Controlador {
            <<abstract>>
            #usuario: Integrante
            #enTransaccion(accion) void
            #consultar(consulta) T
        }
        class ControladorSolicitud {
            <<abstract>>
            #solicitudDAO: SolicitudDAO
            #solicitud: Solicitud
            +abrirSolicitud(solicitudId) Solicitud
            #modificarYGuardar(cambio) void
        }
        class ControladorRegistrarIntervencion {
            +agregarComunicacion(tipo, texto) void
            +registrar(tipo, descripcion, tiempoHoras) BigDecimal
        }
    }
    namespace modelo {
        class Solicitud {
            +registrarIntervencion(intervencion) void
            +calcularTiempoTotal() BigDecimal
            +tienePendientes() boolean
            +tomarPendiente() RegistroSolicitud
        }
        class Intervencion {
            +validar() void
        }
        class CambioEstado
        class ReglaNegocioException {
            <<exception>>
        }
    }
    namespace persistencia {
        class ConexionBD {
            +obtenerConexion()$ Connection
        }
        class DAO~T~ {
            <<interface>>
            +insertar(con, entidad) int
            +buscarPorId(con, id) T
        }
        class SolicitudDAO {
            -daosRegistros: List~RegistroDAO~
            +buscarParaModificar(con, id) Solicitud
            +guardar(con, solicitud) void
        }
        class RegistroDAO~T~ {
            <<abstract>>
            +acepta(registro) boolean
            +guardar(con, registro) void
            +insertar(con, registro)* int
            +listarPorSolicitud(con, solicitud)* List~T~
        }
        class IntervencionDAO
        class CambioEstadoDAO
    }
    Pantalla <|-- PantallaRegistrarIntervencion
    PantallaRegistrarIntervencion *-- PanelIntervencion
    PantallaRegistrarIntervencion ..> Dialogos
    PantallaRegistrarIntervencion ..> ControladorRegistrarIntervencion
    Sesion ..> ControladorRegistrarIntervencion
    ControladorSolicitud --|> Controlador
    ControladorRegistrarIntervencion --|> ControladorSolicitud
    Controlador ..> ConexionBD
    ControladorSolicitud ..> SolicitudDAO
    ControladorSolicitud ..> Solicitud
    ControladorRegistrarIntervencion ..> Intervencion
    Solicitud ..> CambioEstado
    Intervencion ..> ReglaNegocioException
    SolicitudDAO ..|> DAO
    SolicitudDAO o-- RegistroDAO
    RegistroDAO <|-- IntervencionDAO
    RegistroDAO <|-- CambioEstadoDAO
    SolicitudDAO ..> Solicitud
    IntervencionDAO ..> Intervencion
    CambioEstadoDAO ..> CambioEstado
